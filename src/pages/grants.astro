---
// src/pages/grants.astro
import Base from '../layouts/Base.astro';
import { grants, collaborators } from '../data/site.js';
---
<Base title="Grants & Partnerships — Caetano Albuquerque">

  <!-- Header -->
  <div class="bg-grove py-20 px-6">
    <div class="max-w-site mx-auto">
      <p class="font-sans text-xs font-medium text-sage uppercase tracking-widest mb-4">Funding & Partnerships</p>
      <h1 class="font-display text-hero text-straw max-w-2xl leading-tight mb-6">
        Supported by agencies who care about California agriculture.
      </h1>
      <p class="font-serif text-fog/80 text-xl max-w-2xl leading-relaxed">
        Our research is funded by USGS, USDA-linked commodity boards, the CSU system, and the
        U.S. Department of Energy. Total competitive funding as PI or Co-PI: approximately $208,000.
      </p>
    </div>
  </div>

  <!-- Active grants -->
  <section class="py-section bg-straw">
    <div class="max-w-site mx-auto px-6">
      <p class="font-sans text-xs font-medium text-terracotta uppercase tracking-widest mb-6">Current</p>
      <h2 class="font-display text-display text-grove mb-10">Active Grants & Beamtime</h2>
      <div class="space-y-6">
        {grants.filter(g => g.status === 'active').map((g) => (
          <div class="border border-grove/15 bg-fog p-8">
            <div class="flex flex-wrap gap-4 items-start justify-between mb-4">
              <div>
                <p class="font-sans text-xs font-medium text-sage uppercase tracking-wider mb-1">{g.funder}</p>
                <h3 class="font-display text-xl text-grove leading-snug max-w-2xl">{g.title}</h3>
              </div>
              <div class="text-right flex-shrink-0">
                <p class="font-display text-2xl text-terracotta">{g.amount}</p>
                <p class="font-sans text-xs text-ink/40">{g.period}</p>
              </div>
            </div>
            <p class="font-sans text-xs text-terracotta font-medium mb-3">Role: {g.role}</p>
            <p class="font-serif text-sm text-ink/70 leading-relaxed">{g.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Synchrotron note -->
  <section class="py-section-sm bg-grove/95 text-straw">
    <div class="max-w-site mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="font-sans text-xs text-sage uppercase tracking-widest font-medium mb-4">Advanced Light Source · Lawrence Berkeley National Lab</p>
        <h2 class="font-display text-2xl text-gold mb-4">Synchrotron beamtime is competitive. We have it.</h2>
        <p class="font-serif text-fog/80 text-lg leading-relaxed">
          Access to beamline 8.3.2 at the ALS requires a highly competitive proposal process.
          We currently hold 15 shifts across two active allocations — both led by our lab — giving us
          access to the world-class X-ray microCT infrastructure needed to image xylem anatomy
          and collapse at resolutions impossible with conventional microscopy.
        </p>
      </div>
      <div class="border border-grove/30 p-8 bg-grove/50">
        <p class="font-sans text-xs text-sage uppercase tracking-wider font-medium mb-4">Current Allocations</p>
        <div class="space-y-4">
          <div>
            <p class="font-serif text-straw text-sm leading-snug">General User Proposal (GUP) — Beamline 8.3.2</p>
            <p class="font-sans text-xs text-fog/60 mt-1">6 shifts · Xylem conduit implosion under drought and disease · 2025–2026</p>
          </div>
          <div class="border-t border-grove/30 pt-4">
            <p class="font-serif text-straw text-sm leading-snug">RAPIDD Beamtime — Beamline 8.3.2</p>
            <p class="font-sans text-xs text-fog/60 mt-1">9 shifts · Disease resistance traits in lettuce · PI: Albuquerque · 2025–2026</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Collaborator network -->
  <section class="py-section bg-straw">
    <div class="max-w-site mx-auto px-6">
      <p class="font-sans text-xs font-medium text-terracotta uppercase tracking-widest mb-4">Collaboration Network</p>
      <h2 class="font-display text-display text-grove mb-4">Our scientific community</h2>
      <p class="font-serif text-lg text-ink/65 max-w-2xl mb-10">
        Our collaborators span USDA-ARS, UC campuses, and international institutions. These are active
        co-author and grant relationships, not just names.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {collaborators.map((c) => (
          <div class="border border-grove/10 bg-fog p-4">
            <p class="font-sans text-sm font-medium text-grove">{c.name}</p>
            <p class="font-sans text-xs text-ink/45 mt-0.5">{c.affiliation}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partnership inquiry -->
  <section class="py-section-sm bg-terracotta text-straw">
    <div class="max-w-site mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-8">
      <div>
        <h2 class="font-display text-2xl mb-2">Interested in a partnership?</h2>
        <p class="font-serif text-fog/85">
          We are actively seeking collaborations with commodity boards, growers, and agencies working
          on water, nutrient, and disease challenges in vegetable and specialty crops.
        </p>
      </div>
      <a href="/contact" class="flex-shrink-0 bg-straw text-terracotta font-sans font-medium text-sm px-8 py-3 hover:bg-fog transition-colors">
        Get in Touch →
      </a>
    </div>
  </section>

</Base>
