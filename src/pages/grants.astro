---
import Base from '../layouts/Base.astro';
import { person, grants, beamtime, collaborators, fundingSummary } from '../data/site.js';
---
<Base title={`Grants | ${person.name}`}>
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Funding</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Grants and beamtime</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-600">{fundingSummary}</p>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <div class="space-y-6">
        {grants.map((g) => (
          <article class="rounded-[1.5rem] border border-black/5 bg-mist p-6 shadow-sm sm:p-7">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0">
                <p class="text-sm font-medium text-leaf">{g.funder}</p>
                <h2 class="mt-1 max-w-3xl text-lg font-semibold leading-snug tracking-tight text-gray-800 sm:text-xl">{g.title}</h2>
              </div>
              <div class="flex-shrink-0 sm:text-right">
                <p class="text-lg font-semibold text-gray-800">{g.amount}</p>
                <p class="text-sm text-gray-500">{g.period}</p>
              </div>
            </div>
            <p class="mt-3 text-sm font-medium text-gray-700">{g.role}</p>
            <p class="mt-2 text-base leading-7 text-gray-600">{g.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Synchrotron beamtime</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">Advanced Light Source, Lawrence Berkeley National Laboratory</h2>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-gray-600">{beamtime.summary}</p>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {beamtime.allocations.map((a) => (
          <article class="rounded-[1.5rem] border border-black/5 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold tracking-tight text-gray-800">{a.title}</h3>
            <p class="mt-2 text-base leading-7 text-gray-600">{a.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Collaborators</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">People I work with</h2>
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {collaborators.map((c) => (
          <div class="rounded-xl border border-black/5 bg-mist p-4">
            <p class="text-sm font-medium text-gray-800">{c.name}</p>
            <p class="mt-0.5 text-sm text-gray-500">{c.affiliation}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-semibold tracking-tight">Interested in a partnership?</h2>
      <p class="mt-3 max-w-3xl text-lg leading-8 text-gray-600">
        We are actively seeking collaborations with commodity boards, growers, and agencies working
        on water, nutrient, and disease challenges in vegetable and specialty crops.
      </p>
      <a href="/contact" class="mt-6 inline-block rounded-full bg-leaf px-6 py-3 text-sm font-semibold text-white hover:opacity-90">Get in touch</a>
    </div>
  </section>
</Base>
