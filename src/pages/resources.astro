---
// src/pages/resources.astro
// Not in the nav or the sitemap. Add protocols here once they are ready to share.
import Base from '../layouts/Base.astro';
import { person } from '../data/site.js';

const links = [
  { label: 'Advanced Light Source', url: 'https://als.lbl.gov', note: 'Beamline 8.3.2, synchrotron microCT' },
  { label: 'LI-COR LI-6800', url: 'https://www.licor.com/env/products/photosynthesis/', note: 'Gas exchange instrument' },
  { label: 'Dragonfly (ORS)', url: 'https://theobjects.com/dragonfly/', note: '3D CT segmentation and visualization' },
  { label: 'fitplc R package', url: 'https://cran.r-project.org/web/packages/fitplc/index.html', note: 'Fitting vulnerability curves' },
  { label: 'Google Scholar', url: person.scholar, note: 'Full publication list' },
  { label: 'USDA-ARS Salinas', url: 'https://www.ars.usda.gov/pacific-west-area/salinas-ca/', note: 'Partner institution' },
  { label: 'UC ANR Monterey County', url: 'https://ucanr.edu/sites/Monterey/', note: 'Partner institution' },
  { label: 'California Leafy Greens Research Board', url: 'https://lgr.ucdavis.edu', note: 'Funding partner' },
];
---
<Base
  title={`Resources | ${person.name}`}
  description="Tools and data sources used in the Albuquerque lab."
>
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Resources</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-600">
        Tools we use in the lab. If you want to repeat something from one of our papers,
        or talk about methods, write to me.
      </p>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {links.map((l) => (
          <a href={l.url} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-black/5 bg-mist p-5 transition hover:border-leaf/40">
            <p class="text-base font-medium text-gray-800">{l.label}</p>
            <p class="mt-1 text-sm text-gray-500">{l.note}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-semibold tracking-tight">Data availability</h2>
      <p class="mt-3 max-w-3xl text-lg leading-8 text-gray-600">
        Data behind our published papers are available on reasonable request, and we deposit them
        in public repositories at publication. For specific datasets, write to
        <a href={`mailto:${person.email}`} class="text-leaf underline underline-offset-4">{person.email}</a>.
      </p>
    </div>
  </section>
</Base>
