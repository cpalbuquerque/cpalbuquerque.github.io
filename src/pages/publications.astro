---
import Base from '../layouts/Base.astro';
import { person, publications, inPreparation } from '../data/site.js';

// Wrap "Albuquerque C" in bold and keep the student markers readable.
function authorHtml(authors) {
  return authors
    .replace(/&/g, '&amp;')
    .replace(/Albuquerque C\b/, '<strong>Albuquerque C</strong>');
}

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
---

<Base
  title={`Publications | ${person.name}`}
  description="Papers, preprints and datasets on plant water transport, xylem embolism and collapse, with student authors marked."
>
  <section class="bg-paper">
    <div class="mx-auto max-w-4xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        Publications
      </h1>
      <p class="mt-6 text-base leading-7 text-gray-600">
        Student authors: * undergraduate mentee, ** co-mentored graduate student.
        Full list on <a href={person.scholar} target="_blank" rel="noopener noreferrer" class="text-leaf underline underline-offset-4">Google Scholar</a>.
      </p>

      <section class="mt-12">
        <h2 class="text-2xl font-semibold tracking-tight text-gray-800 sm:text-3xl">
          Accepted, under review and in preparation
        </h2>
        <div class="mt-5 space-y-6 border-t border-black/10 pt-5">
          {inPreparation.map((p) => (
            <article>
              <p class="text-base leading-8 text-gray-600 sm:text-lg">
                <span set:html={authorHtml(p.authors)} /> {p.title} <em>{p.status}</em>
              </p>
              {p.link && (
                <p class="mt-1">
                  <a href={p.link} target="_blank" rel="noopener noreferrer" class="text-sm text-leaf underline underline-offset-4 hover:text-leaf-dark sm:text-base">
                    {p.linkLabel}
                  </a>
                </p>
              )}
            </article>
          ))}
        </div>
      </section>

      <div class="mt-12 space-y-12">
        {years.map((year) => (
          <section>
            <h2 class="text-2xl font-semibold tracking-tight text-gray-800 sm:text-3xl">
              {year}
            </h2>
            <div class="mt-5 space-y-6 border-t border-black/10 pt-5">
              {publications.filter((p) => p.year === year).map((p) => (
                <article>
                  <p class="text-base leading-8 text-gray-600 sm:text-lg">
                    <span set:html={authorHtml(p.authors)} /> ({p.year}) {p.title} <em>{p.journal}</em>{p.volume ? `, ${p.volume}` : ''}.
                  </p>
                  {p.doi && (
                    <p class="mt-1">
                      <a href={p.doi} target="_blank" rel="noopener noreferrer" class="break-all text-sm text-leaf underline underline-offset-4 hover:text-leaf-dark sm:text-base">
                        {p.doi.replace('https://doi.org/', 'doi:')}
                      </a>
                    </p>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>
