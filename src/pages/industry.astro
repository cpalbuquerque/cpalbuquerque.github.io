---
import Base from '../layouts/Base.astro';
---

<Base title="Industry Survey — Caetano Albuquerque">
  <section class="bg-[#FCFCF8]">
    <div class="mx-auto max-w-5xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        Industry Survey
      </h1>

      <div class="mt-8 overflow-hidden rounded-[1.5rem] border border-black/5 bg-white p-3 shadow-sm sm:p-4">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSc5K59lB_LsahZxFA00xjOIrkHvVxXo6aBtxzpvy9Lft6voKQ/viewform?embedded=true"
          width="100%"
          height="1250"
          style="border:0;"
          marginheight="0"
          marginwidth="0"
          title="Industry survey"
          class="w-full"
        >
          Loading…
        </iframe>
      </div>

      <div class="mt-6">
        <a
          href="https://docs.google.com/forms/d/e/1FAIpQLSc5K59lB_LsahZxFA00xjOIrkHvVxXo6aBtxzpvy9Lft6voKQ/viewform"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex rounded-full bg-[#5F7C63] px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90 sm:text-base"
        >
          Open survey in a new tab
        </a>
      </div>
    </div>
  </section>
</Base>