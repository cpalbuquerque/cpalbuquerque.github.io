---
import Base from '../layouts/Base.astro';
import { person } from '../data/site.js';

const questions = [
  {
    title: 'Which fails first: shape or water?',
    text: 'As a leaf dries, tension in the xylem rises. Conduits can lose their water to an air bubble (embolism), or their walls can buckle inward while still full of water (collapse). We track both, conduit by conduit, in the same organ.',
  },
  {
    title: 'What comes back?',
    text: 'Collapse is like a kinked garden hose. When water returns, the kink can open again. Embolism is more like a broken pipe. In our grapevine scans, collapsed conduits mostly recover overnight after rewatering, while embolized conduits mostly stay empty.',
  },
  {
    title: 'Does it matter for the whole plant?',
    text: 'We link what we see in the scans to leaf hydraulic conductance, gas exchange and water potential. The aim is to know when collapse is a cost and when it is a safe, reversible way to ride out a hot afternoon.',
  },
  {
    title: 'Is it the same across species?',
    text: 'We compare California natives, model species, C3 and C4 grasses, grapevine, lettuce and almond. Crops are the half of the comparison we can grow, water and control, so we use them to test ideas that come from the wild species.',
  },
];

const methods = [
  'Synchrotron microCT at the Advanced Light Source, Lawrence Berkeley National Laboratory (beamline 8.3.2)',
  'Leaf and root hydraulic conductance',
  'Water potential with the pressure chamber, and pressure volume curves',
  'Leaf gas exchange',
  'Leaf anatomy and 3D image segmentation',
];
---
<Base
  title={`Research | ${person.name}`}
  description="Water-filled xylem conduits collapse before they embolize, and collapse reverses overnight while embolism mostly does not. Synchrotron microCT, hydraulics and gas exchange across natives, grasses and crops."
>
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Research</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-semibold tracking-tight sm:text-5xl">
        {person.focus}
      </h1>
      <div class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-gray-600">
        <p>
          Plants move water from soil to leaf through a network of tiny pipes, the xylem. Drought and heat
          put that network under tension. My lab asks how it fails, and whether it recovers.
        </p>
        <p>
          The central finding so far is simple to say. Water-filled conduits collapse before they embolize.
          Collapse reverses overnight, while embolism mostly does not.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Questions</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">What we are asking</h2>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {questions.map((q) => (
          <article class="rounded-[1.5rem] border border-black/5 bg-mist p-7 shadow-sm">
            <h3 class="text-xl font-semibold tracking-tight">{q.title}</h3>
            <p class="mt-4 text-base leading-8 text-gray-600">{q.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Methods</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">How we measure it</h2>
          <ul class="mt-6 list-disc space-y-2 pl-5 text-base leading-8 text-gray-600">
            {methods.map((m) => <li>{m}</li>)}
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Students</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">Who does the work</h2>
          <p class="mt-6 text-base leading-8 text-gray-600">
            Undergraduates run most of these measurements. They learn the pressure chamber, gas exchange
            and image analysis, and many present their own posters.
            See <a href="/people" class="text-leaf underline underline-offset-4">People</a> for the current group.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
