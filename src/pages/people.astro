---
import Base from '../layouts/Base.astro';
import { person, currentStudents, alumni, alumniNote } from '../data/site.js';

function initials(name) {
  return name
    .replace(/^Dr\.\s*/, '')
    .split(' ')
    .map((n) => n[0])
    .join('')
    .toUpperCase();
}
---

<Base title={`People | ${person.name}`}>
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        People
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-600">
        An undergraduate lab that studies how plant water transport fails under drought and heat,
        and how it recovers.
      </p>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">
        Principal Investigator
      </p>

      <div class="mt-8 grid gap-10 md:grid-cols-[0.6fr_1.4fr] md:items-start">
        <div class="overflow-hidden rounded-[1.5rem] border border-black/5 bg-mist shadow-sm">
          <img
            src="/img/caetano-portrait.jpg"
            alt="Caetano Albuquerque"
            width="293"
            height="293"
            class="w-full object-cover"
            loading="lazy"
          />
        </div>

        <div>
          <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
            {person.name}
          </h2>

          <p class="mt-2 text-base text-gray-500 sm:text-lg">
            {person.title}
          </p>

          <div class="mt-6 space-y-5 text-base leading-8 text-gray-600 sm:text-lg">
            <p>
              I am a plant physiologist. I study how water transport in plants fails under drought
              and heat, and whether it recovers. I trained with Andrew McElrone at UC Davis (PhD),
              and as a postdoc at UC Davis and at Cal State LA with Christine Scoffoni, working
              closely with Lawren Sack.
            </p>

            <p>
              My lab uses synchrotron microCT, hydraulic measurements and gas exchange on California
              natives, model species, grasses and crops. Undergraduates do most of this work, and
              I build my teaching around the same questions.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap gap-5 border-t border-black/10 pt-6">
            <a href={`mailto:${person.email}`} class="text-sm font-medium text-leaf underline underline-offset-4 hover:text-leaf-dark sm:text-base">
              {person.email}
            </a>
            <a href={person.scholar} target="_blank" rel="noopener noreferrer" class="text-sm text-gray-600 underline underline-offset-4 hover:text-gray-800 sm:text-base">
              Google Scholar
            </a>
            <a href={person.orcid} target="_blank" rel="noopener noreferrer" class="text-sm text-gray-600 underline underline-offset-4 hover:text-gray-800 sm:text-base">
              ORCID
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">
        Current Group
      </p>

      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Current students
      </h2>

      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {currentStudents.map((student) => (
          <article class="rounded-[1.5rem] border border-black/5 bg-white p-6 shadow-sm">
            <div class="mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-leaf-pale text-lg font-semibold text-leaf-dark">
              {initials(student.name)}
            </div>
            <h3 class="text-xl font-semibold tracking-tight text-gray-800">{student.name}</h3>
            <p class="mt-1 text-sm font-medium text-leaf">{student.role}</p>
            <p class="mt-1 text-sm text-gray-500">{student.year}</p>
            {student.project && <p class="mt-4 text-base leading-8 text-gray-600">{student.project}</p>}
            {student.note && <p class="mt-3 text-sm text-gray-600">{student.note}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">
        Alumni
      </p>

      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Former lab members
      </h2>

      <p class="mt-4 max-w-3xl text-lg leading-8 text-gray-600">{alumniNote}</p>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {alumni.map((p) => (
          <article class="rounded-[1.5rem] border border-black/5 bg-mist p-6 shadow-sm">
            <h3 class="text-xl font-semibold tracking-tight text-gray-800">{p.name}</h3>
            <p class="mt-1 text-sm font-medium text-leaf">{p.role}</p>
            <p class="mt-1 text-sm text-gray-500">{p.period}</p>
            <p class="mt-4 text-base leading-8 text-gray-600">{p.outcome}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
