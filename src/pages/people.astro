---
import Base from '../layouts/Base.astro';
import { news, currentStudents, alumni } from '../data/site.js';

const studentNews = news.filter((n) => n.type === 'Student News');

function initials(name) {
  return name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .toUpperCase();
}
---

<Base title="People — Caetano Albuquerque">
  <section class="bg-[#FCFCF8]">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        People
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-[#4B5563]">
        A research group focused on crop stress physiology, water and nutrient management,
        and field-relevant questions in California specialty crop systems.
      </p>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
        Principal Investigator
      </p>

      <div class="mt-8 grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:items-start">
        <div class="overflow-hidden rounded-[1.5rem] border border-black/5 bg-[#F7F8F4] shadow-sm">
          <img
            src="/img/caetano-portrait.jpg"
            alt="Caetano Albuquerque"
            class="w-full object-cover"
            loading="lazy"
          />
        </div>

        <div>
          <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
            Caetano Albuquerque
          </h2>

          <p class="mt-2 text-base text-[#6B7280] sm:text-lg">
            Assistant Professor of Agronomy and Horticulture · California State University Monterey Bay
          </p>

          <div class="mt-6 space-y-5 text-base leading-8 text-[#4B5563] sm:text-lg">
            <p>
              I am a plant scientist working at the intersection of agronomy, horticulture,
              and crop physiology. My research focuses on how crops respond to water deficit,
              disease-related stress, and nutrient limitations, with emphasis on vegetable crop
              systems in California and the Salinas Valley.
            </p>

            <p>
              My work combines field, greenhouse, and controlled-environment approaches to better
              understand crop performance and support more practical management decisions for specialty crops.
            </p>

            <p>
              I am committed to mentoring students through hands-on research experiences that build
              scientific skills, confidence, and stronger pathways into plant and agricultural sciences.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap gap-5 border-t border-black/10 pt-6">
            <a
              href="mailto:calbuquerque@csumb.edu"
              class="text-sm font-medium text-[#5F7C63] underline underline-offset-4 hover:text-[#3F5D45] sm:text-base"
            >
              calbuquerque@csumb.edu
            </a>

            <a
              href="https://scholar.google.com/citations?user=FnRaXGoAAAAJ"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-[#4B5563] underline underline-offset-4 hover:text-[#1F2937] sm:text-base"
            >
              Google Scholar
            </a>

            <a
              href="https://orcid.org/0000-0001-6222-3996"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-[#4B5563] underline underline-offset-4 hover:text-[#1F2937] sm:text-base"
            >
              ORCID
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {studentNews.length > 0 && (
    <section class="border-t border-black/5 bg-[#F7F8F4]">
      <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
          Student Highlights
        </p>

        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {studentNews.map((item) => (
            <article class="rounded-[1.5rem] border border-black/5 bg-white p-6 shadow-sm">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-medium text-[#5F7C63]">{item.type}</span>
                <span class="text-sm text-[#9CA3AF]">·</span>
                <span class="text-sm text-[#6B7280]">{item.date}</span>
              </div>

              <h3 class="mt-3 text-xl font-semibold tracking-tight text-[#1F2937]">
                {item.headline}
              </h3>

              <p class="mt-4 text-base leading-8 text-[#4B5563]">
                {item.body}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
        Current Group
      </p>

      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Current students
      </h2>

      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {currentStudents.map((student) => (
          <article class="rounded-[1.5rem] border border-black/5 bg-[#F7F8F4] p-6 shadow-sm">
            {student.photo ? (
              <img
                src={student.photo}
                alt={student.name}
                class="mb-5 h-28 w-28 rounded-full object-cover"
                loading="lazy"
              />
            ) : (
              <div class="mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-[#DCE7DD] text-lg font-semibold text-[#3F5D45]">
                {initials(student.name)}
              </div>
            )}

            <h3 class="text-xl font-semibold tracking-tight text-[#1F2937]">
              {student.name}
            </h3>

            <p class="mt-1 text-sm font-medium text-[#5F7C63]">
              {student.role}
            </p>

            <p class="mt-1 text-sm text-[#6B7280]">
              {student.year}
            </p>

            <p class="mt-4 text-base leading-8 text-[#4B5563]">
              {student.project}
            </p>

            {student.internship && (
              <p class="mt-4 text-sm font-medium text-[#1F2937]">
                Internship: <span class="text-[#4B5563]">{student.internship}</span>
              </p>
            )}

            {student.awards && student.awards.length > 0 && (
              <div class="mt-4">
                <p class="text-sm font-medium text-[#1F2937]">Awards</p>
                <ul class="mt-2 space-y-1 text-sm text-[#4B5563]">
                  {student.awards.map((award) => (
                    <li>{award}</li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  {alumni.length > 0 && (
    <section class="border-t border-black/5 bg-[#F7F8F4]">
      <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
          Alumni
        </p>

        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Alumni and former lab members
        </h2>

        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {alumni.map((person) => (
            <article class="rounded-[1.5rem] border border-black/5 bg-white p-6 shadow-sm">
              <h3 class="text-xl font-semibold tracking-tight text-[#1F2937]">
                {person.name}
              </h3>

              <p class="mt-1 text-sm font-medium text-[#5F7C63]">
                {person.role}
              </p>

              <p class="mt-1 text-sm text-[#6B7280]">
                {person.period}{person.institution ? ` · ${person.institution}` : ''}
              </p>

              <p class="mt-4 text-base leading-8 text-[#4B5563]">
                {person.outcome}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>