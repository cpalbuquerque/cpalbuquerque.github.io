---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { person, collaborators } from '../data/site.js';
import { loadPeople, findPhoto } from '../lib/content.js';

const { people } = loadPeople();
const inGroup = (g) => people.filter((p) => p.group === g);

const current = inGroup('current');
const visiting = inGroup('visiting');
const masters = inGroup('masters');
const alumniGroups = [
  { label: 'CSU Monterey Bay', list: inGroup('alumni-csumb') },
  { label: 'Cal State LA', list: inGroup('alumni-calstatela') },
  { label: 'UC Davis and USDA-ARS', list: inGroup('alumni-ucdavis') },
].filter((g) => g.list.length);

// A portrait shows only when captions.txt lists one.
const portrait = findPhoto(/^portrait\.(jpe?g|png|webp)$/i);
// Optional: students with instruments (not portraits).
const lab = findPhoto(/^students_lettuce_field\./);
const almond = findPhoto(/^data_almond_vulnerability\./);
const mentoring = findPhoto(/^mentoring_hoop_house\./);

const withNote = (p) => (p.line ? `${p.name} (${p.line})` : p.name);
---

<Base
  title="People"
  description="Current lab members, co-mentored graduate students, alumni and collaborators of the Albuquerque plant physiology lab at CSU Monterey Bay."
>
  <h1 class="text-2xl">People</h1>

  <section class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-start">
    {portrait && (
      <Image src={portrait.image} alt={portrait.caption} width={160} class="h-auto w-28 sm:w-40" />
    )}
    <div class="max-w-measure">
      <h2 class="text-lg">{person.name}</h2>
      <p class="text-muted">{person.role}, {person.unit}, {person.institution}</p>
      <p class="mt-2">Plant physiologist studying how plants respond to drought and recover from it, across scales, relating structure and function.</p>
      <p class="mt-2">
        <a href={person.scholar}>Google Scholar</a>
        <span class="muted"> · </span>
        <a href={person.orcid}>ORCID</a>
      </p>
    </div>
  </section>

  <p class="mt-10 max-w-measure text-muted">
    47 undergraduates and three master's students mentored since 2016, and one visiting postdoctoral scholar hosted; 16 student conference presentations since 2024.
  </p>

  <section>
    <h2 class="section-title">Research training</h2>
    <div class="prose-block mt-4">
      <p>
        Students in the lab learn plant physiology methods by using them on their own questions: water
        potential with the pressure chamber, stomatal conductance and gas exchange, pressure-volume curves,
        leaf hydraulic conductance, quantitative anatomy from hand sections, and analysis of synchrotron
        microCT scans.
      </p>
      <p>
        Each student moves through the same sequence with growing independence: protocol training, a
        dataset they own, a poster, then a role in a manuscript, with authorship rules written down at the
        start. Students are paid through my grants, present at regional and national meetings, and meet my
        collaborators for summer research and graduate school.
      </p>
    </div>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 sm:items-start">
      {mentoring && (
        <figure>
          <Image src={mentoring.image} alt={mentoring.caption} widths={[420, 833]} sizes="(min-width: 640px) 25rem, 100vw" class="h-auto w-full" />
          <figcaption class="mt-2 text-sm text-muted">{mentoring.caption}</figcaption>
        </figure>
      )}
      {almond && (
        <figure>
          <Image src={almond.image} alt={almond.caption} widths={[420, 840]} sizes="(min-width: 640px) 25rem, 100vw" class="h-auto w-full border border-rule" />
          <figcaption class="mt-2 text-sm text-muted">{almond.caption}</figcaption>
        </figure>
      )}
    </div>
  </section>

  {current.length > 0 && (
    <section>
      <h2 class="section-title">Current lab members</h2>
      {lab && (
        <figure class="mt-4 max-w-md">
          <Image src={lab.image} alt={lab.caption} widths={[600, 1000]} sizes="(min-width: 768px) 38rem, 100vw" class="h-auto w-full" />
          <figcaption class="mt-2 text-sm text-muted">{lab.caption}</figcaption>
        </figure>
      )}
      <ul class="mt-4 grid gap-x-8 gap-y-1 sm:grid-cols-2">
        {current.map((p) => (
          <li>{p.name}{p.line && <span class="text-muted">, {p.line}</span>}</li>
        ))}
      </ul>
    </section>
  )}

  {visiting.length > 0 && (
    <section>
      <h2 class="section-title">Visiting scholar hosted</h2>
      <ul class="mt-4 max-w-measure space-y-1">
        {visiting.map((p) => (
          <li>{p.name}{p.years && <span class="text-muted">, {p.years}</span>}{p.line && <span class="text-muted">. {p.line.charAt(0).toUpperCase() + p.line.slice(1)}.</span>}</li>
        ))}
      </ul>
    </section>
  )}

  {masters.length > 0 && (
    <section>
      <h2 class="section-title">Graduate students co-mentored</h2>
      <p class="mt-4 max-w-measure">
        {masters.map((p) => p.name).join(', ')}
        <span class="text-muted"> (master's, Cal State LA, 2021 to 2023)</span>
      </p>
      <p class="mt-2 max-w-measure text-muted">Eduardo Barragan and Jesse Gomez are now PhD students, at UCLA and the University of Wisconsin-Madison.</p>
    </section>
  )}

  {alumniGroups.length > 0 && (
    <section>
      <h2 class="section-title">Alumni</h2>
      {alumniGroups.map((g) => (
        <div class="mt-4 max-w-measure">
          <h3 class="text-base">{g.label}</h3>
          <p class="mt-1 text-muted">{g.list.map(withNote).join(', ')}</p>
        </div>
      ))}
    </section>
  )}

  <section>
    <h2 class="section-title">Collaborators</h2>
    <ul class="mt-4 grid gap-1 text-muted sm:grid-cols-2">
      {collaborators.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <p class="mt-10 max-w-measure">Posters, internships and other lab news are on the <a href="/news/">News</a> page.</p>
</Base>
