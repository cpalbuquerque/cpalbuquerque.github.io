---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { person } from '../data/site.js';
import { loadPeople, findPhoto } from '../lib/content.js';

const { people } = loadPeople();
const inGroup = (g) => people.filter((p) => p.group === g);

const current = inGroup('current');
const visiting = inGroup('visiting');
const masters = inGroup('masters');
const alumniGroups = [
  { label: 'CSU Monterey Bay', list: inGroup('alumni-csumb') },
  { label: 'Cal State LA', list: inGroup('alumni-calstatela') },
  { label: 'UC Davis and USDA-ARS', list: inGroup('alumni-ucdavis') },
].filter((g) => g.list.length);

// A portrait shows only when captions.txt lists one.
const portrait = findPhoto(/^portrait\.(jpe?g|png|webp)$/i);
const mentoring = findPhoto(/^mentoring_hoop_house\./);
const hahn = findPhoto(/^hahn-microscope\./);

const steps = [
  { title: 'Learn a protocol', text: 'Each student starts by learning one measurement well, with written protocols and practice on the bench.', photo: findPhoto(/^student-microscope-2\./) },
  { title: 'Run the measurement', text: 'Students collect their own dataset: water potential, gas exchange, pressure-volume curves, leaf hydraulic conductance, anatomy or microCT scans.', photo: findPhoto(/^students-bench\./) },
  { title: 'Analyze and present', text: 'They analyze the data themselves and present it as a poster at regional and national meetings.', photo: findPhoto(/^poster-almond\./) },
  { title: 'Publish', text: 'Students take a role in a manuscript when their work becomes part of a paper. Student authors are marked on the Publications page.', link: '/publications/' },
];

const withNote = (p) => (p.line ? `${p.name} (${p.line})` : p.name);
---

<Base
  title="People"
  description="Current lab members, co-mentored graduate students and alumni of the Albuquerque plant physiology lab at CSU Monterey Bay."
>
  <h1>People</h1>

  <section class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-start">
    {portrait && (
      <Image src={portrait.image} alt={portrait.caption} widths={[240, 320]} sizes="(min-width: 768px) 160px, 120px" formats={['avif', 'webp']} loading="eager" class="h-auto w-[120px] rounded md:w-[160px]" />
    )}
    <div class="max-w-measure">
      <h2>{person.name}</h2>
      <p class="text-muted">{person.role}, {person.unit}, {person.institution}</p>
      <p class="mt-2">Plant physiologist. I study how plants lose and recover water transport during drought, from the xylem conduit to the whole plant.</p>
      <p class="mt-2">
        <a href={person.scholar}>Google Scholar</a>
        <span class="muted"> · </span>
        <a href={person.orcid}>ORCID</a>
      </p>
    </div>
  </section>

  <p class="mt-10 max-w-measure text-muted">
    47 undergraduates and three master's students mentored since 2016, and one visiting postdoctoral scholar hosted. Students have given 16 conference presentations since 2024.
  </p>

  <section class="section">
    <h2>Research training</h2>
    <p class="mt-3 max-w-measure text-muted">
      Students learn plant physiology methods by using them on their own questions, with growing
      independence at each step.
    </p>
    <ol class="mt-6 grid gap-8 sm:grid-cols-2">
      {steps.map((st, i) => (
        <li>
          {st.photo && (
            <Image src={st.photo.image} alt={st.photo.caption} widths={[400, 800]} sizes="(min-width: 640px) 22rem, 92vw" formats={['avif', 'webp']} class="aspect-[4/3] h-auto w-full rounded object-cover" />
          )}
          <h3 class={st.photo ? 'mt-3' : ''}>{i + 1}. {st.title}</h3>
          <p class="mt-1 text-muted">{st.text}</p>
          {st.link && <p class="mt-2"><a href={st.link}>See publications</a></p>}
        </li>
      ))}
    </ol>
  </section>

  {current.length > 0 && (
    <section>
      <h2 class="section-title">Current lab members</h2>
      {mentoring && (
        <figure class="mt-4 max-w-md">
          <Image src={mentoring.image} alt={mentoring.caption} widths={[400, 800]} sizes="(min-width: 640px) 28rem, 92vw" formats={['avif', 'webp']} class="h-auto w-full rounded" />
          <figcaption>{mentoring.caption}</figcaption>
        </figure>
      )}
      <ul class="mt-4 grid gap-x-8 gap-y-1 sm:grid-cols-2">
        {current.map((p) => (
          <li>{p.name}{p.line && <span class="text-muted">, {p.line}</span>}</li>
        ))}
      </ul>
    </section>
  )}

  {visiting.length > 0 && (
    <section>
      <h2 class="section-title">Visiting scholar hosted</h2>
      {hahn && (
        <figure class="mt-4 max-w-sm">
          <Image src={hahn.image} alt={hahn.caption} widths={[400, 800]} sizes="(min-width: 640px) 24rem, 92vw" formats={['avif', 'webp']} class="h-auto w-full rounded" />
          <figcaption>{hahn.caption}</figcaption>
        </figure>
      )}
      <ul class="mt-4 max-w-measure space-y-1">
        {visiting.map((p) => (
          <li>{p.name}{p.years && <span class="text-muted">, {p.years}</span>}{p.line && <span class="text-muted">. {p.line.charAt(0).toUpperCase() + p.line.slice(1)}.</span>}</li>
        ))}
      </ul>
    </section>
  )}

  {masters.length > 0 && (
    <section>
      <h2 class="section-title">Graduate students co-mentored</h2>
      <p class="mt-4 max-w-measure">
        {masters.map((p) => p.name).join(', ')}
        <span class="text-muted"> (master's, Cal State LA, 2021 to 2023)</span>
      </p>
      <p class="mt-2 max-w-measure text-muted">Eduardo Barragan and Jesse Gomez are now PhD students, at UCLA and the University of Wisconsin-Madison.</p>
    </section>
  )}

  {alumniGroups.length > 0 && (
    <section>
      <h2 class="section-title">Alumni</h2>
      {alumniGroups.map((g) => (
        <div class="mt-4 max-w-measure">
          <h3 class="text-base">{g.label}</h3>
          <p class="mt-1 text-muted">{g.list.map(withNote).join(', ')}</p>
        </div>
      ))}
    </section>
  )}


  <p class="mt-10 max-w-measure">Posters, internships and other lab news are on the <a href="/news/">News</a> page.</p>
</Base>
