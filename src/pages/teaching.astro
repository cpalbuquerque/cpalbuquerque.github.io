---
import Base from '../layouts/Base.astro';
import { courses } from '../data/site.js';

const csumbCourses = courses.map((course) => ({
  code: course.code,
  title: course.title,
}));

const previousTeaching = [
  {
    institution: 'California State University, Los Angeles',
    courses: ['BIOL 5430 — Seminar Ecology: Environmental Biology'],
  },
];
---

<Base title="Teaching — Caetano Albuquerque">
  <section class="bg-[#FCFCF8]">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        Teaching
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-[#4B5563]">
        Courses in plant science, agronomy, and horticulture that connect biological principles
        with agricultural systems and field-based questions.
      </p>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr]">
        <div>
          <div class="overflow-hidden rounded-[1.5rem] border border-black/5 bg-[#F7F8F4] shadow-sm">
            <img
              src="/img/lab-field.jpg"
              alt="Field teaching and lab group in lettuce"
              class="h-[260px] w-full object-cover sm:h-[320px]"
              loading="lazy"
            />
          </div>
          <p class="mt-3 text-xs text-[#6B7280]">
            Photo: Brent Dundore-Arias
          </p>
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
            California State University Monterey Bay
          </p>

          <ul class="mt-6 space-y-3 text-base leading-8 text-[#4B5563] sm:text-lg">
            {csumbCourses.map((course) => (
              <li>
                <span class="font-medium text-[#1F2937]">{course.code}</span> — {course.title}
              </li>
            ))}
          </ul>

          <div class="mt-10">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
              Previous Teaching
            </p>

            {previousTeaching.map((group) => (
              <div class="mt-4">
                <h2 class="text-lg font-semibold tracking-tight text-[#1F2937]">
                  {group.institution}
                </h2>
                <ul class="mt-3 space-y-2 text-base leading-8 text-[#4B5563]">
                  {group.courses.map((course) => (
                    <li>{course}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>