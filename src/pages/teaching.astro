---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { findPhoto } from '../lib/content.js';

const workshop = findPhoto(/^synaps_workshop\./);
const waterPath = findPhoto(/^water-path\./);

const csumb = [
  {
    code: 'BIO 332',
    title: 'Plant Physiology',
    terms: 'Fall 2023 to 2026',
    text: 'How plants take up, move and lose water, fix carbon and respond to stress, from cells to the whole plant. Since Fall 2026 every student annotates synchrotron microCT scans of grapevine petioles from the Advanced Light Source for SYNAPS-I, a Berkeley Lab project, and two students from my lab help lead this work. The water relations units are taught with The Water Path.',
    photo: workshop,
  },
  {
    code: 'BIO 106',
    title: 'Introduction to Plant Sciences, with laboratory',
    terms: 'Spring 2024 and 2026',
    text: 'An introductory plant biology course with laboratory for students from several majors.',
  },
  {
    code: 'AGPS 350',
    title: 'Research Methods for Crop and Soil Sciences, with laboratory',
    terms: 'Fall 2023 to 2026',
    text: 'Experimental design and statistics in R, taught alongside two laboratory sections. Since Fall 2026 students annotate synchrotron microCT scans and use statistics to count embolized conduits and measure tissue shrinkage. The redesign was supported by a systemwide CSU LIFT award for teaching innovation, one of 45 funded from about 260 proposals.',
  },
  {
    code: 'AGPS 415',
    title: 'Advanced Irrigation and Nutrient Management',
    terms: 'Spring 2024 to 2026',
    text: 'How water and nutrient supply shape crop growth and plant water status. Students grow vegetables under different irrigation and nutrient levels in a hoop house, harvest and analyze them, and measure plant water status with the pressure chamber.',
  },
  {
    code: 'AGPS 213',
    title: 'Principles of Viticulture',
    terms: 'Spring 2025 and 2026',
    text: 'The biology and management of grapevines. A course I proposed and designed. It is now part of the catalog.',
  },
  {
    code: 'AGPS 209',
    title: 'Plants, Agriculture, and Climate Change',
    terms: 'Spring 2024 and 2025',
    text: 'How plants and crops respond to a changing climate. A course I proposed and designed. It is now part of the catalog.',
  },
  {
    code: 'AGPS 397',
    title: 'Independent Research in Agriculture',
    terms: '2024 and 2025',
    text: 'Semester-long research projects with individual students, from stomata in lettuce under different irrigation levels to propagating wine grapes from woody cuttings.',
  },
];
---

<Base
  title="Teaching"
  description="Courses taught by Caetano Albuquerque at CSU Monterey Bay, including Plant Physiology with synchrotron microCT research for every student, and The Water Path, an interactive course site."
>
  <h1>Teaching</h1>
  <p class="mt-4 max-w-measure">
    I teach plant science fundamentals and have students use them on data, much of it collected by
    students with the tools researchers use.
  </p>

  <section class="band mt-8 rounded px-4 py-6 sm:px-6 md:py-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:gap-8">
      <div class="md:flex-1">
        <h2>The Water Path</h2>
        <p class="mt-2 max-w-measure">
          An interactive site I built for the water relations units of Plant Physiology. Students follow
          water from the soil through roots, stems and leaves to the air, in seven stops.
        </p>
        <p class="mt-4"><a href="/water-path/" class="btn">Open The Water Path</a></p>
      </div>
      {waterPath && (
        <a href="/water-path/" class="block md:w-[26rem] md:shrink-0">
          <Image src={waterPath.image} alt={waterPath.caption} widths={[480, 900]} sizes="(min-width: 768px) 26rem, 92vw" formats={['avif', 'webp']} loading="eager" class="h-auto w-full rounded border border-rule" />
        </a>
      )}
    </div>
  </section>

  <section class="section">
    <h2>Courses at CSU Monterey Bay</h2>
    <ul class="mt-6 space-y-6">
      {csumb.map((c) => (
        <li class={c.photo ? 'flex flex-col gap-4 md:flex-row md:items-start md:gap-8' : ''}>
          <div class="max-w-measure md:flex-1">
            <p><span class="font-semibold text-head">{c.code}, {c.title}</span> <span class="text-sm text-muted">({c.terms})</span></p>
            <p class="mt-1 text-muted">{c.text}</p>
          </div>
          {c.photo && (
            <figure class="max-w-xs md:w-64 md:shrink-0">
              <Image src={c.photo.image} alt={c.photo.caption} widths={[400, 640]} sizes="(min-width: 768px) 16rem, 92vw" formats={['avif', 'webp']} class="h-auto w-full rounded" />
              <figcaption>{c.photo.caption}</figcaption>
            </figure>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2>Earlier teaching</h2>
    <ul class="mt-6 max-w-measure space-y-5">
      <li>
        <p><span class="font-semibold text-head">BIOL 5430, Seminar in Ecology: Plants and Climate Change</span> <span class="text-sm text-muted">(Cal State LA, Spring 2022)</span></p>
        <p class="mt-1 text-muted">A graduate seminar I designed on plant responses to drought, built on readings, discussion and student presentations.</p>
      </li>
      <li>
        <p><span class="font-semibold text-head">Guest lectures</span></p>
        <p class="mt-1 text-muted">Graduate seminars in horticulture at UC Davis and in plant biology at UC Riverside, and Plant Physiology and Integrative Organismal Biology at Cal State LA, all in 2022. River Hydrology at CSU Monterey Bay in 2023.</p>
      </li>
      <li>
        <p><span class="font-semibold text-head">Teaching assistant, Grapevine Growth and Physiology (VEN 110)</span> <span class="text-sm text-muted">(UC Davis, 2017)</span></p>
      </li>
    </ul>
  </section>
</Base>
