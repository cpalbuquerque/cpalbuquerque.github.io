---
import Base from '../layouts/Base.astro';
import { courses } from '../data/site.js';

const csumbCourses = courses;
const previousTeaching = [
  {
    institution: 'California State University, Los Angeles',
    courses: ['BIOL 5430 — Seminar Ecology: Environmental Biology'],
  },
];
---

<Base title="Teaching — Caetano Albuquerque">
  <section class="bg-[#FCFCF8]">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        Teaching
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-[#4B5563]">
        My teaching brings together plant science, agronomy, and horticulture through courses
        that connect biological principles with agricultural systems, field-based questions,
        and applied problem-solving.
      </p>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="overflow-hidden rounded-[1.5rem] border border-black/5 bg-[#F7F8F4] shadow-sm">
          <img
            src="/img/hero-salinas-field.jpg"
            alt="Teaching and field activities"
            class="w-full object-cover"
            loading="lazy"
          />
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
            California State University Monterey Bay
          </p>

          <div class="mt-6 grid gap-5">
            {csumbCourses.map((course) => (
              <article class="rounded-[1.5rem] border border-black/5 bg-[#F7F8F4] p-6 shadow-sm">
                <h2 class="text-xl font-semibold tracking-tight text-[#1F2937]">
                  {course.code} — {course.title}
                </h2>

                <p class="mt-2 text-sm font-medium text-[#6B7280]">
                  {course.level}
                </p>

                <p class="mt-4 text-base leading-8 text-[#4B5563]">
                  {course.description}
                </p>

                {course.fieldTrip && (
                  <p class="mt-4 text-sm text-[#4B5563]">
                    <span class="font-medium text-[#1F2937]">Field component:</span> {course.fieldTrip}
                  </p>
                )}

                {course.guestLecturers && course.guestLecturers.length > 0 && (
                  <div class="mt-4">
                    <p class="text-sm font-medium text-[#1F2937]">Selected guest speakers</p>
                    <ul class="mt-2 space-y-1 text-sm text-[#4B5563]">
                      {course.guestLecturers.map((guest) => (
                        <li>{guest}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-[#F7F8F4]">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
        Previous Teaching
      </p>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {previousTeaching.map((group) => (
          <article class="rounded-[1.5rem] border border-black/5 bg-white p-6 shadow-sm">
            <h2 class="text-xl font-semibold tracking-tight text-[#1F2937]">
              {group.institution}
            </h2>

            <ul class="mt-4 space-y-2 text-base leading-8 text-[#4B5563]">
              {group.courses.map((course) => (
                <li>{course}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>