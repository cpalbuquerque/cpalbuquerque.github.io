---
import Base from '../layouts/Base.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { person, courses } from '../data/site.js';

const agCourses = courses.filter((c) => c.code.startsWith('AGPS'));

const previousTeaching = [
  {
    institution: 'California State University, Los Angeles',
    courses: ['BIOL 5430, Seminar Ecology: Environmental Biology (graduate course on plants and climate change)'],
  },
];
---

<Base
  title={`Teaching | ${person.name}`}
  description="Plant Physiology for 100 students, with a course based research experience on synchrotron microCT scans. Introduction to Plant Sciences with lab. The Water Path course site."
>
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        Teaching
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-600">
        I teach with research. In Plant Physiology, every student contributes to an active
        research project and works with real data from my lab.
      </p>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">BIO 332</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Plant Physiology</h2>
          <div class="mt-6 space-y-5 text-base leading-8 text-gray-600 sm:text-lg">
            <p>
              Plant Physiology has 100 students in Fall 2026. It is a lecture course with no lab,
              so I built the research into the lecture.
            </p>
            <p>
              A course based research experience makes up 20 percent of the grade. Students annotate
              synchrotron microCT scans of grapevine petioles from the Advanced Light Source.
              Their annotations help train AI segmentation for SYNAPS-I, a Berkeley Lab project
              within the Department of Energy Genesis Mission.
            </p>
            <p>
              Two students from my lab attended a microCT annotation workshop at Berkeley Lab,
              and they help lead the annotation work in class.
            </p>
          </div>
        </div>
        <PhotoSlot label="CURE class at laptops, shot from behind or at an angle, with caption" />
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <a href="/water-path/" class="block rounded-[1.5rem] border border-black/5 bg-white p-7 shadow-sm transition hover:-translate-y-0.5 sm:p-9">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Course site</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">The Water Path</h2>
        <p class="mt-4 max-w-3xl text-base leading-8 text-gray-600 sm:text-lg">
          The Water Path, an interactive course site for the water relations units of Plant Physiology:
          students predict before each figure, work with real data from my lab, and see which numbers
          are measured and which are illustrative.
        </p>
        <p class="mt-5 text-base font-semibold text-leaf underline underline-offset-4">Open The Water Path</p>
      </a>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-10 md:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">BIO 106</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">Introduction to Plant Sciences</h2>
          <p class="mt-4 text-base leading-8 text-gray-600 sm:text-lg">
            An introductory course with laboratory, taken by students from several majors.
          </p>
        </div>
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Teaching award</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">CSU LIFT</h2>
          <p class="mt-4 text-base leading-8 text-gray-600 sm:text-lg">
            A systemwide award for teaching innovation. Mine was one of 45 funded from about 260 proposals.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Agriculture courses</p>
          <ul class="mt-6 space-y-3 text-base leading-8 text-gray-600 sm:text-lg">
            {agCourses.map((c) => (
              <li><span class="font-medium text-gray-800">{c.code}</span>, {c.title}</li>
            ))}
          </ul>

          <p class="mt-10 text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Previous teaching</p>
          {previousTeaching.map((group) => (
            <div class="mt-4">
              <h3 class="text-lg font-semibold tracking-tight text-gray-800">{group.institution}</h3>
              <ul class="mt-2 space-y-2 text-base leading-8 text-gray-600 sm:text-lg">
                {group.courses.map((course) => <li>{course}</li>)}
              </ul>
            </div>
          ))}
        </div>

        <figure>
          <img
            src="/img/lab-field.webp"
            alt="Field teaching with the lab group in a lettuce field"
            width="1200"
            height="800"
            class="w-full rounded-[1.5rem] border border-black/5 object-cover shadow-sm"
            loading="lazy"
          />
          <figcaption class="mt-3 text-xs text-gray-500">Photo: Brent Dundore-Arias</figcaption>
        </figure>
      </div>
    </div>
  </section>
</Base>
