---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { person } from '../data/site.js';
import { findPhoto, loadLogos } from '../lib/content.js';

const hero = findPhoto(/^leaf-in-sun\./);
const logos = loadLogos();

// Students per project come only from the CV (final October 2026 version). An empty list shows nothing.
// Only people not marked CONFIRM in content/people.txt are named.
const projects = [
  {
    title: 'Loss and recovery of water transport in the xylem',
    text: 'Synchrotron microCT of intact plants through drought and rewatering, alongside leaf hydraulics and gas exchange.',
    photo: findPhoto(/^microct_grapevine\./),
    students: ['Joe Perez', 'Angela Diaz'],
  },
  {
    title: 'Aquaporins and the living cells',
    text: 'Grapevines lacking the aquaporin VvPIP2;1, to separate the living pathway from the xylem.',
    photo: findPhoto(/^method_gas_exchange\./),
    students: [],
  },
  {
    title: 'Dry air and dry soil',
    text: 'Whether drought reached through dry air or through drying soil is equally recoverable.',
    photo: findPhoto(/^method_pressure_chamber\./),
    students: [],
  },
  {
    title: 'Water delivery and disease in lettuce',
    text: 'Student projects on inner leaves and tipburn, and on Fusarium wilt in the xylem.',
    photo: findPhoto(/^poster-lettuce-leaves\./),
    students: ['Melissa Martinez', 'Bella Hartman', 'Joe Perez'],
  },
];

const band = [/^student-microscope-1\./, /^evaporative-flux-bench\./, /^poster-lettuce-recovery\./]
  .map((r) => findPhoto(r))
  .filter(Boolean);
const methods = [/^students-bench\./, /^root-hydraulics\./, /^leaf-water-drops\./].map((r) => findPhoto(r)).filter(Boolean);
---

<Base
  pageTitle="Caetano Albuquerque | Plant Physiology Lab, CSU Monterey Bay"
  description="Caetano Albuquerque, plant physiologist at CSU Monterey Bay. I study how plants move water, how drought and disease disrupt it, and how it recovers."
>
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:gap-10">
    <div class="max-w-text md:flex-1">
      <h1>{person.name}</h1>
      <p class="mt-3 text-lg text-muted">
        Plant physiologist. I study how plants move water, how drought and disease disrupt it, and how it
        recovers.
      </p>
    </div>
    {hero && (
      <figure class="w-full max-w-[22rem] md:w-80 md:shrink-0">
        <Image src={hero.image} alt={hero.caption} widths={[400, 640, 960]} sizes="(min-width: 768px) 20rem, 90vw" formats={['avif', 'webp']} loading="eager" class="h-auto w-full" />
        <figcaption>{hero.caption}</figcaption>
      </figure>
    )}
  </div>

  <div class="prose-block mt-8">
    <p>
      My lab studies how plants respond to drought and disease, and the mechanisms behind those
      responses. We compare several plant species, including crops such as grapevine, lettuce and almond.
    </p>
    <p>
      A central question is how water transport declines under stress and how it recovers when conditions
      improve, after the soil is rewatered or the air becomes less dry. We combine plant physiology and
      hydraulics with imaging to connect structure and function.
    </p>
  </div>

  <section class="section">
    <h2>Current projects</h2>
    <ul class="mt-6 grid gap-8 sm:grid-cols-2">
      {projects.map((p) => (
        <li class="flex gap-4">
          {p.photo && (
            <Image src={p.photo.image} alt={p.photo.caption} widths={[160, 320]} sizes="6rem" formats={['avif', 'webp']} class="h-24 w-24 shrink-0 rounded object-cover" />
          )}
          <div>
            <h3>{p.title}</h3>
            <p class="mt-1 text-muted">{p.text}</p>
            {p.students.length > 0 && <p class="mt-1 text-sm text-muted">Students: {p.students.join(', ')}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  {band.length > 0 && (
    <section class="section">
      <h2>Research with undergraduates</h2>
      <p class="mt-3 max-w-measure text-muted">
        Undergraduates run most of the measurements in the lab and present their own work.
        <a href="/people/">Meet the lab</a>.
      </p>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        {band.map((p) => (
          <figure>
            <a href="/people/" class="block">
              <Image src={p.image} alt={p.caption} widths={[400, 800]} sizes="(min-width: 640px) 20rem, 92vw" formats={['avif', 'webp']} class="aspect-[4/3] h-auto w-full object-cover" />
            </a>
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <h2>Earlier work</h2>
    <div class="mt-4 flex max-w-measure gap-4">
      <a href="https://doi.org/10.1093/jxb/eraa392" class="shrink-0">
        <img src="/img/jxb-2020-cover.webp" width="240" height="313" alt="Cover of Journal of Experimental Botany, volume 71, issue 22, 2020" class="h-auto w-20 border border-rule" loading="lazy" />
      </a>
      <p>
        In grapevine leaves imaged alive with microCT, leaf hydraulic conductance and gas exchange declined
        early in drought without xylem embolism.
        <a href="https://doi.org/10.1093/jxb/eraa392">Albuquerque et al. 2020, <em>Journal of Experimental Botany</em></a>, journal cover.
      </p>
    </div>
  </section>

  <section class="section">
    <h2>Methods</h2>
    <p class="mt-4 max-w-measure">
      Pressure chamber, gas exchange, pressure-volume curves, leaf and root hydraulic conductance, optical
      vulnerability, quantitative anatomy, and synchrotron microCT.
    </p>
    {methods.length > 0 && (
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        {methods.map((p) => (
          <figure>
            <Image src={p.image} alt={p.caption} widths={[400, 800]} sizes="(min-width: 640px) 20rem, 92vw" formats={['avif', 'webp']} class="aspect-[4/3] h-auto w-full object-cover" />
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>

  {logos.length > 0 && (
    <section class="section">
      <h2>Supported by</h2>
      <ul class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-6" aria-label="Funders and facilities">
        {logos.map((l) => (
          <li>
            {l.url ? (
              <a href={l.url} class="flex items-center gap-2 text-sm text-muted no-underline">
                <Image src={l.image} alt={l.showName ? '' : l.org} height={l.tall ? 160 : 72} class={`w-auto opacity-80 grayscale ${l.tall ? 'h-16 md:h-[4.5rem]' : 'h-8 md:h-9'}`} />
                {l.showName && <span class="max-w-[11rem] leading-tight">{l.org}</span>}
              </a>
            ) : (
              <span class="flex items-center gap-2 text-sm text-muted">
                <Image src={l.image} alt={l.showName ? '' : l.org} height={l.tall ? 160 : 72} class={`w-auto opacity-80 grayscale ${l.tall ? 'h-16 md:h-[4.5rem]' : 'h-8 md:h-9'}`} />
                {l.showName && <span class="max-w-[11rem] leading-tight">{l.org}</span>}
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
