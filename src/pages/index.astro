---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { person, funding } from '../data/site.js';
import { findPhoto, loadLogos } from '../lib/content.js';

const microct = findPhoto(/^microct_grapevine\.(jpe?g|png|webp)$/i);
// TODO: logo files in content/logos/ listed in logos.txt.
const logos = loadLogos();

const projects = [
  {
    title: 'Collapse and recovery of the xylem',
    text: 'Synchrotron microCT of intact plants through drought and rewatering, alongside leaf hydraulics and gas exchange.',
  },
  {
    title: 'Aquaporins and the living cells',
    text: 'Grapevines lacking the aquaporin VvPIP2;1, to separate the living pathway from the xylem.',
  },
  {
    title: 'Dry air and dry soil',
    text: 'Whether drought reached through dry air or through drying soil is equally recoverable.',
  },
  {
    title: 'Water delivery and disease in lettuce',
    text: 'Student projects on inner leaves and tipburn, and on Fusarium wilt in the xylem.',
  },
];
---

<Base
  title="Research"
  description="Caetano Albuquerque, plant physiologist at CSU Monterey Bay: how plants respond to drought and recover, across scales and relating structure and function."
>
  <h1 class="text-2xl">{person.name}</h1>
  <p class="mt-1 max-w-measure text-muted">
    Plant physiologist. How plants respond to drought and recover from it, across scales, relating
    structure and function.
  </p>

  <div class="mt-8 flex flex-col gap-6 md:flex-row md:items-start">
    <div class="prose-block md:flex-1">
      <p>
        I combine physiological measurements with synchrotron microCT imaging at the Advanced Light Source,
        Lawrence Berkeley National Laboratory, from the conduit to the whole plant.
      </p>
      <p>
        Drought damage to the xylem is usually described as embolism, which is mostly permanent. Imaging
        intact grapevines, I found that water-filled conduits collapse before they embolize, and most
        reopen after rewatering. A collapsed conduit is a kinked garden hose. An embolized conduit is a
        broken pipe.
      </p>
      <p>
        I am now asking how much of the loss and recovery of leaf water transport comes from this
        collapse, and how much from aquaporins in the living cells.
      </p>
    </div>
    {microct && (
      <figure class="max-w-xs md:w-56 md:shrink-0">
        <Image src={microct.image} alt={microct.caption} widths={[448, 672]} sizes="(min-width: 768px) 14rem, 100vw" class="h-auto w-full" />
        <figcaption class="mt-2 text-sm text-muted">{microct.caption}</figcaption>
      </figure>
    )}
  </div>

  <h2 class="section-title">Current projects</h2>
  <dl class="mt-4 max-w-measure space-y-4">
    {projects.map((p) => (
      <div>
        <dt class="font-semibold">{p.title}</dt>
        <dd class="text-muted">{p.text}</dd>
      </div>
    ))}
  </dl>

  <h2 class="section-title">Earlier work</h2>
  <div class="mt-4 flex max-w-measure gap-4">
    <a href="https://doi.org/10.1093/jxb/eraa392" class="shrink-0 hover:bg-transparent">
      <img src="/img/jxb-2020-cover.webp" width="240" height="313" alt="Cover of Journal of Experimental Botany, volume 71, issue 22, 2020" class="h-auto w-20 border border-rule" loading="lazy" />
    </a>
    <p>
      In grapevine leaves imaged alive with microCT, leaf hydraulic conductance and gas exchange declined
      early in drought without xylem embolism.
      <a href="https://doi.org/10.1093/jxb/eraa392">Albuquerque et al. 2020, <em>Journal of Experimental Botany</em></a>, journal cover.
    </p>
  </div>

  <h2 class="section-title">Methods</h2>
  <p class="mt-4 max-w-measure">
    Pressure chamber, gas exchange, pressure-volume curves, leaf hydraulic conductance, optical
    vulnerability, quantitative anatomy, and synchrotron microCT at beamline 8.3.2 of the Advanced Light
    Source.
  </p>

  <h2 class="section-title">Funding</h2>
  <ul class="mt-4 max-w-measure space-y-2 text-sm text-muted">
    {[...funding.research, ...funding.teaching].map((g) => (
      <li><span class="text-ink">{g.funder}.</span> {g.title}. {g.role}, {g.years}.</li>
    ))}
    <li><span class="text-ink">Advanced Light Source, beamline 8.3.2.</span> Synchrotron beamtime, 15 shifts across two proposals.</li>
  </ul>

  {logos.length > 0 && (
    <ul class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-6" aria-label="Funders and facilities">
      {logos.map((l) => (
        <li>
          <a href={l.url} class="flex items-center gap-2 text-sm text-muted no-underline hover:bg-transparent">
            <Image src={l.image} alt={l.showName ? '' : l.org} height={72} class="h-8 w-auto opacity-80 grayscale hover:opacity-100 md:h-10" />
            {l.showName && <span class="max-w-[11rem] leading-tight">{l.org}</span>}
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
