---
import Base from '../layouts/Base.astro';
import { news } from '../data/site.js';

const latestNews = news.slice(0, 5);
---

<Base title="Caetano Albuquerque — Agronomy and Horticulture, CSUMB">
  <section class="border-b border-black/5 bg-[#FCFCF8]">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
            Agronomy · Horticulture · Crop Physiology
          </p>

          <h1 class="mt-4 max-w-4xl text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            Caetano Albuquerque
          </h1>

          <p class="mt-4 text-lg text-[#4B5563] sm:text-xl">
            Assistant Professor of Agronomy and Horticulture at California State University Monterey Bay
          </p>

       <p class="mt-8 max-w-3xl text-lg leading-8 text-[#4B5563] sm:text-xl sm:leading-9">
  Integrating water management, crop stress physiology, and sensing approaches to improve irrigation decisions,
  reduce water use and nitrate leaching, and support climate adaptation in vegetable crop systems in California,
  with emphasis on the Salinas Valley. Our lab also studies other crops grown in California and how plant
  functional traits compare across species.
</p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="#research"
              class="rounded-full bg-[#5F7C63] px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90 sm:text-base"
            >
              View research
            </a>

            <a
              href="/publications"
              class="rounded-full border border-[#DCE7DD] bg-white px-6 py-3 text-sm font-semibold text-[#1F2937] transition hover:border-[#5F7C63] hover:text-[#5F7C63] sm:text-base"
            >
              Publications
            </a>
          </div>
        </div>

<div class="mx-auto w-full max-w-xs sm:max-w-sm lg:max-w-sm">
  <div class="overflow-hidden rounded-[2rem] border border-black/5 bg-white shadow-[0_14px_40px_rgba(0,0,0,0.06)]">
    <img
      src="/img/caetano-portrait.jpg"
      alt="Portrait of Caetano Albuquerque"
      class="h-[420px] w-full object-cover object-top sm:h-[480px]"
      loading="eager"
    />
  </div>
</div>
      </div>
    </div>
  </section>

  <section id="research" class="bg-white">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-18 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
          Research
        </p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Research areas
        </h2>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <article class="rounded-[1.5rem] border border-black/5 bg-[#F7F8F4] p-7 shadow-sm">
          <h3 class="text-xl font-semibold tracking-tight">Water & nutrient management</h3>
          <p class="mt-4 text-base leading-8 text-[#4B5563]">
            Field- and greenhouse-based work focused on improving irrigation and nutrient management in specialty crop systems.
          </p>
        </article>

        <article class="rounded-[1.5rem] border border-black/5 bg-[#F7F8F4] p-7 shadow-sm">
          <h3 class="text-xl font-semibold tracking-tight">Crop stress physiology</h3>
          <p class="mt-4 text-base leading-8 text-[#4B5563]">
            Physiological and anatomical responses to drought, salinity, and disease-related stress.
          </p>
        </article>

        <article class="rounded-[1.5rem] border border-black/5 bg-[#F7F8F4] p-7 shadow-sm">
          <h3 class="text-xl font-semibold tracking-tight">Sensing & decision tools</h3>
          <p class="mt-4 text-base leading-8 text-[#4B5563]">
            Proximal sensing, imaging, and quantitative tools to better understand crop status and support management decisions.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-[#F7F8F4]">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-18 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <a href="/publications" class="rounded-[1.5rem] border border-black/5 bg-white p-7 shadow-sm transition hover:-translate-y-0.5">
          <h3 class="text-xl font-semibold tracking-tight">Publications</h3>
          <p class="mt-4 text-base leading-8 text-[#4B5563]">
            Selected peer-reviewed publications.
          </p>
        </a>

        <a href="/industry" class="rounded-[1.5rem] border border-black/5 bg-white p-7 shadow-sm transition hover:-translate-y-0.5">
          <h3 class="text-xl font-semibold tracking-tight">Industry survey</h3>
          <p class="mt-4 text-base leading-8 text-[#4B5563]">
            Stakeholder input on research priorities in specialty crop systems.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section id="news" class="bg-white">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-18 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
          News
        </p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Updates
        </h2>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {latestNews.map((item) => (
          <article class="overflow-hidden rounded-[1.5rem] border border-black/5 bg-[#F7F8F4] shadow-sm">
            {item.image && (
              <img
                src={item.image}
                alt={item.headline}
                class="h-56 w-full object-cover"
                loading="lazy"
              />
            )}

            <div class="p-7">
              <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[#5F7C63]">
                {item.date}
              </p>

              <p class="mt-2 text-sm font-medium text-[#6B7280]">
                {item.type}
              </p>

              <h3 class="mt-3 text-xl font-semibold tracking-tight">
                {item.headline}
              </h3>

              <p class="mt-4 text-base leading-8 text-[#4B5563]">
                {item.body}
              </p>

              {item.link && (
                <p class="mt-5">
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-semibold text-[#5F7C63] underline underline-offset-4 hover:text-[#3F5D45] sm:text-base"
                  >
                    Learn more
                  </a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="bg-[#F7F8F4]">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-18 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#5F7C63]">
            Contact
          </p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
            Get in touch
          </h2>
        </div>

        <div class="rounded-[1.5rem] border border-black/5 bg-white p-7 shadow-sm">
          <div class="space-y-5 text-base text-[#4B5563] sm:text-lg">
            <p>
              <span class="font-semibold text-[#1F2937]">Email:</span>
              <a href="mailto:calbuquerque@csumb.edu" class="ml-2 hover:text-[#5F7C63]">calbuquerque@csumb.edu</a>
            </p>
            <p>
              <span class="font-semibold text-[#1F2937]">Institution:</span>
              <span class="ml-2">California State University Monterey Bay</span>
            </p>
            <p>
              <span class="font-semibold text-[#1F2937]">Focus:</span>
              <span class="ml-2">Vegetable crop systems in California, especially the Salinas Valley</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>