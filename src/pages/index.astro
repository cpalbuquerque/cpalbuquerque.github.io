---
import Base from '../layouts/Base.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { news, person, labStats } from '../data/site.js';

const latestNews = news.slice(0, 4);
const description = 'Caetano Albuquerque studies how water transport in plants fails under drought and heat, and whether it recovers. Undergraduate plant physiology lab at CSU Monterey Bay.';

const threads = [
  {
    title: 'Collapse before embolism',
    text: 'Under drought, water-filled conduits in the xylem can collapse inward before any air enters them. We image this in 3D with synchrotron microCT and ask what it costs the plant.',
  },
  {
    title: 'Recovery overnight',
    text: 'A collapsed conduit is like a kinked garden hose. An embolized conduit is a broken pipe. In our scans, collapse reverses after rewatering while embolism mostly does not.',
  },
  {
    title: 'Many plants, one question',
    text: 'We compare California natives, model species, grasses, grapevine, lettuce and almond. Crops are the half of the comparison we can grow and control.',
  },
];
---

<Base title={`${person.name} | Plant Physiology Lab, CSU Monterey Bay`} description={description}>
  <section class="border-b border-black/5 bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">
            Plant physiology · Water transport · Undergraduate research
          </p>

          <h1 class="mt-4 max-w-4xl text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            {person.name}
          </h1>

          <p class="mt-4 text-lg text-gray-600 sm:text-xl">
            {person.title}
          </p>

          <p class="mt-8 max-w-3xl text-xl leading-9 text-gray-800 sm:text-2xl sm:leading-10">
            {person.focus}
          </p>

          <p class="mt-5 max-w-3xl text-base leading-8 text-gray-600 sm:text-lg">
            {labStats.current}
          </p>

          <p class="mt-3 text-sm text-gray-500">
            ORCID <a href={person.orcid} target="_blank" rel="noopener noreferrer" class="text-leaf underline underline-offset-4">{person.orcidId}</a>
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/research"
              class="rounded-full bg-leaf px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90 sm:text-base"
            >
              View research
            </a>

            <a
              href="/publications"
              class="rounded-full border border-leaf-pale bg-white px-6 py-3 text-sm font-semibold text-gray-800 transition hover:border-leaf hover:text-leaf sm:text-base"
            >
              Publications
            </a>
          </div>
        </div>

        <div class="mx-auto w-full max-w-xs sm:max-w-sm lg:max-w-sm">
          <div class="overflow-hidden rounded-[2rem] border border-black/5 bg-white shadow-[0_14px_40px_rgba(0,0,0,0.06)]">
            <img
              src="/img/caetano-portrait.jpg"
              alt="Portrait of Caetano Albuquerque"
              width="293"
              height="293"
              class="h-[420px] w-full object-cover object-top sm:h-[480px]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="research" class="bg-white">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-18 lg:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">
            Research
          </p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
            How water transport fails, and how it comes back
          </h2>
        </div>
        <PhotoSlot label="microCT cross section of a petiole (published, or no results shown), with a one sentence caption" />
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {threads.map((t) => (
          <article class="rounded-[1.5rem] border border-black/5 bg-mist p-7 shadow-sm">
            <h3 class="text-xl font-semibold tracking-tight">{t.title}</h3>
            <p class="mt-4 text-base leading-8 text-gray-600">{t.text}</p>
          </article>
        ))}
      </div>

      <p class="mt-8">
        <a href="/research" class="text-base font-semibold text-leaf underline underline-offset-4 hover:text-leaf-dark">
          More on the research
        </a>
      </p>
    </div>
  </section>

  <section class="bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-18 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <a href="/publications" class="rounded-[1.5rem] border border-black/5 bg-white p-7 shadow-sm transition hover:-translate-y-0.5">
          <h3 class="text-xl font-semibold tracking-tight">Publications</h3>
          <p class="mt-4 text-base leading-8 text-gray-600">
            Papers, preprints and datasets, with student authors marked.
          </p>
        </a>

        <a href="/water-path/" class="rounded-[1.5rem] border border-black/5 bg-white p-7 shadow-sm transition hover:-translate-y-0.5">
          <h3 class="text-xl font-semibold tracking-tight">The Water Path</h3>
          <p class="mt-4 text-base leading-8 text-gray-600">
            My interactive course site for the water relations units of Plant Physiology, built on real data from the lab.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section id="news" class="bg-white">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-18 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">
          News
        </p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Updates
        </h2>
      </div>


      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {latestNews.map((item) => (
          <article class="overflow-hidden rounded-[1.5rem] border border-black/5 bg-mist shadow-sm">
            <div class="p-7">
              <p class="text-sm font-semibold uppercase tracking-[0.14em] text-leaf">
                {item.type}{item.date && ` · ${item.date}`}
              </p>
              <h3 class="mt-3 text-xl font-semibold tracking-tight">
                {item.headline}
              </h3>
              <p class="mt-4 text-base leading-8 text-gray-600">
                {item.body}
              </p>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-8">
        <a href="/news" class="text-base font-semibold text-leaf underline underline-offset-4 hover:text-leaf-dark">All news</a>
      </p>
    </div>
  </section>
</Base>
