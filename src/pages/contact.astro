---
import Base from '../layouts/Base.astro';
import { person } from '../data/site.js';

const notes = [
  {
    who: 'Students',
    what: 'Students at any level who are curious about how plants handle drought are welcome to write. No experience needed. Tell me a little about yourself, what caught your interest, and your schedule this semester.',
  },
  {
    who: 'Future graduate students and postdocs',
    what: 'If you are thinking about graduate school or a postdoc in plant water relations, I am happy to talk about ideas, programs and people to work with.',
  },
  {
    who: 'Collaborators',
    what: 'Send a short note on the question and the timeline. I am most useful when there is a clear question to start from.',
  },
];

const profiles = [
  { label: 'Google Scholar', url: person.scholar },
  { label: 'ResearchGate', url: person.researchgate },
  { label: 'LinkedIn', url: person.linkedin },
].filter((p) => p.url);
---
<Base
  title={`Contact | ${person.name}`}
  description="Students at any level who are curious about how plants handle drought are welcome to write. No experience needed."
>
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Contact</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-600">
        The best way to reach me is by email.
      </p>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-12 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="space-y-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Email</p>
          <a href={`mailto:${person.email}`} class="mt-2 inline-block break-all text-xl font-medium text-gray-800 underline underline-offset-4 hover:text-leaf sm:text-2xl">
            {person.email}
          </a>
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Where</p>
          <div class="mt-2 text-base leading-7 text-gray-600">
            <p>Department of Biology, Agriculture and Chemistry</p>
            <p>California State University, Monterey Bay</p>
            <p>Seaside, CA 93955</p>
          </div>
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">ORCID</p>
          <a href={person.orcid} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-base text-gray-800 underline underline-offset-4 hover:text-leaf">
            {person.orcidId}
          </a>
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-leaf">Profiles</p>
          <ul class="mt-2 space-y-2">
            {profiles.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-base text-gray-800 underline underline-offset-4 hover:text-leaf">{p.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="space-y-6">
        {notes.map((n) => (
          <div class="border-l-2 border-leaf/40 pl-5">
            <h2 class="text-lg font-semibold tracking-tight text-gray-800">{n.who}</h2>
            <p class="mt-1 text-base leading-7 text-gray-600">{n.what}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
