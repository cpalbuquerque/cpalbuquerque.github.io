---
import Base from '../layouts/Base.astro';
import { person } from '../data/site.js';
---

<Base
  title="Contact"
  description="Contact Caetano Albuquerque at CSU Monterey Bay. Students curious about how plants handle drought are welcome to write."
>
  <h1 class="text-2xl">Contact</h1>

  <ul class="mt-6 space-y-1">
    <li class="font-semibold">{person.name}</li>
    <li>{person.role}, {person.unit}, {person.institution}</li>
    <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
    <li><a href={person.scholar}>Google Scholar</a></li>
    <li>ORCID <a href={person.orcid}>{person.orcidId}</a></li>
  </ul>

  <p class="mt-8 max-w-measure">
    Students who are curious about how plants handle drought are welcome to write. No experience is needed to start.
  </p>
</Base>
