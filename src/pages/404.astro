---
// src/pages/404.astro
import Base from '../layouts/Base.astro';
import { person } from '../data/site.js';
---
<Base title={`Page not found | ${person.name}`}>
  <section class="bg-paper">
    <div class="mx-auto max-w-xl px-5 py-24 text-center">
      <p class="font-mono text-7xl text-leaf/30">404</p>
      <h1 class="mt-6 text-3xl font-semibold tracking-tight">Page not found</h1>
      <p class="mt-4 text-lg leading-8 text-gray-600">
        This page does not exist or has moved. Try the menu above, or go back to the home page.
      </p>
      <a href="/" class="mt-8 inline-block rounded-full bg-leaf px-6 py-3 text-sm font-semibold text-white hover:opacity-90">
        Back to home
      </a>
    </div>
  </section>
</Base>
