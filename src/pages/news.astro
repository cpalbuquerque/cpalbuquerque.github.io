---
import Base from '../layouts/Base.astro';
import { person, news } from '../data/site.js';
---

<Base
  title={`News | ${person.name}`}
  description="News from the lab: student research, microCT training at Berkeley Lab, outreach with high school students, and posters."
>
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        News
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-600">
        What students in the lab have been doing.
      </p>
    </div>
  </section>

  <section class="border-t border-black/5 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-2">
        {news.map((item) => (
          <article class="overflow-hidden rounded-[1.5rem] border border-black/5 bg-mist shadow-sm">
            {item.image && (
              <img
                src={item.image}
                alt={item.headline}
                width={item.imageWidth}
                height={item.imageHeight}
                class="h-56 w-full object-cover"
                loading="lazy"
              />
            )}

            <div class="p-7">
              <p class="text-sm font-medium text-leaf">
                {item.type}{item.date && <span class="text-gray-500"> · {item.date}</span>}
              </p>

              <h2 class="mt-3 text-xl font-semibold tracking-tight text-gray-800">
                {item.headline}
              </h2>

              <p class="mt-4 text-base leading-8 text-gray-600">
                {item.body}
              </p>

              {item.link && (
                <p class="mt-5">
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-semibold text-leaf underline underline-offset-4 hover:text-leaf-dark sm:text-base"
                  >
                    Learn more
                  </a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
