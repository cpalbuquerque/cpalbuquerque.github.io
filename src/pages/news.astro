---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { news } from '../data/news.js';
import { findPhoto, loadPhotos } from '../lib/content.js';

const byFile = Object.fromEntries(loadPhotos().map((p) => [p.file, p]));

const photos = [findPhoto(/^synaps_berkeley_lab\./)].filter(Boolean);
const posters = [/^poster-oscar-2026\./, /^poster-lettuce-leaves\./, /^poster-almond\./, /^poster-lettuce-recovery\./, /^poster-with-student\./]
  .map((r) => findPhoto(r))
  .filter(Boolean);
---

<Base
  title="News"
  description="News from the Albuquerque plant physiology lab at CSU Monterey Bay: student posters, internships and training."
>
  <h1>News</h1>

  {photos.length > 0 && (
    <div class="mt-6 max-w-2xl">
      {photos.map((p, i) => (
        <figure>
          <Image src={p.image} alt={p.caption} widths={[400, 720, 1100]} sizes="(min-width: 768px) 42rem, 92vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="h-auto w-full rounded" />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  )}

  {posters.length > 0 && (
    <section class="section">
      <h2>Student posters</h2>
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
        {posters.map((p) => (
          <figure>
            <Image src={p.image} alt={p.caption} widths={[320, 640]} sizes="(min-width: 640px) 20rem, 46vw" formats={['avif', 'webp']} class="aspect-[4/5] h-auto w-full rounded object-cover" />
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="section">
  <h2>Lab news</h2>
  <ul class="mt-4 max-w-measure divide-y divide-rule">
    {news.map((n) => (
      <li class="py-4">
        <p class="text-sm font-semibold text-muted">{n.date}</p>
        <p class="mt-1">{n.text}</p>
        {n.photo && byFile[n.photo] && (
          <figure class="mt-3 max-w-sm">
            <Image src={byFile[n.photo].image} alt={byFile[n.photo].caption} widths={[400, 700]} sizes="(min-width: 640px) 24rem, 92vw" formats={['avif', 'webp']} class="h-auto max-h-80 w-auto rounded" />
            <figcaption>{byFile[n.photo].caption}</figcaption>
          </figure>
        )}
      </li>
    ))}
  </ul>
  </section>
</Base>
