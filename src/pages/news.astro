---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { news } from '../data/news.js';
import { findPhoto, loadPhotos } from '../lib/content.js';

const byFile = Object.fromEntries(loadPhotos().map((p) => [p.file, p]));

const photos = [findPhoto(/^synaps_berkeley_lab\./), findPhoto(/^poster-with-student\./)].filter(Boolean);
---

<Base
  title="News"
  description="News from the Albuquerque plant physiology lab at CSU Monterey Bay: student posters, internships and training."
>
  <h1>News</h1>

  {photos.length > 0 && (
    <div class="mt-6 grid gap-6 sm:grid-cols-[2fr_1fr] sm:items-start">
      {photos.map((p, i) => (
        <figure>
          <Image src={p.image} alt={p.caption} widths={[480, 960, 1200]} sizes={i === 0 ? '(min-width: 640px) 40rem, 92vw' : '(min-width: 640px) 20rem, 92vw'} formats={['avif', 'webp']} loading={i === 0 ? 'eager' : 'lazy'} class="h-auto w-full rounded" />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  )}

  <ul class="mt-8 max-w-measure divide-y divide-rule">
    {news.map((n) => (
      <li class="py-4">
        <p class="text-sm font-semibold text-muted">{n.date}</p>
        <p class="mt-1">{n.text}</p>
        {n.photo && byFile[n.photo] && (
          <figure class="mt-3 max-w-sm">
            <Image src={byFile[n.photo].image} alt={byFile[n.photo].caption} widths={[400, 700]} sizes="(min-width: 640px) 24rem, 92vw" formats={['avif', 'webp']} class="h-auto max-h-80 w-auto rounded" />
            <figcaption>{byFile[n.photo].caption}</figcaption>
          </figure>
        )}
      </li>
    ))}
  </ul>
</Base>
