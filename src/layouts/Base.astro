---
import { person } from '../data/site.js';

const defaultDescription = `${person.name}, ${person.title}. Plant physiologist studying how water transport in plants fails under drought and heat, and whether it recovers. Undergraduate research lab.`;

const {
  title = `${person.name} | Plant Physiology, CSU Monterey Bay`,
  description = defaultDescription,
  // TODO: 1200x630 share image, made from a photo in pass 2 (for example /img/share.jpg).
  ogImage = null,
} = Astro.props;

const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : null;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/people', label: 'People' },
  { href: '/publications', label: 'Publications' },
  { href: '/teaching', label: 'Teaching' },
  { href: '/grants', label: 'Grants' },
  { href: '/news', label: 'News' },
  { href: '/contact', label: 'Contact' },
];

const sameAs = [person.orcid, person.scholar, person.researchgate, person.linkedin].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: 'Assistant Professor',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'California State University, Monterey Bay',
    url: 'https://csumb.edu',
  },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of California, Davis' },
  knowsAbout: ['plant physiology', 'plant water relations', 'xylem', 'drought', 'microCT'],
  email: `mailto:${person.email}`,
  url: 'https://cpalbuquerque.github.io/',
  identifier: { '@type': 'PropertyValue', propertyID: 'ORCID', value: person.orcidId },
  sameAs,
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-screen bg-paper text-gray-800 antialiased">
    <header class="sticky top-0 z-50 border-b border-black/5 bg-paper/95 backdrop-blur">
      <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-3 py-4 md:flex-row md:items-center md:justify-between">
          <div class="min-w-0">
            <a href="/" class="block text-xl font-semibold tracking-tight sm:text-2xl">
              {person.name}
            </a>
            <p class="mt-1 text-sm text-gray-600 sm:text-base">
              {person.title}
            </p>
          </div>

          <nav aria-label="Main" class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-gray-600 sm:text-base">
            {nav.map((item) => {
              const active = item.href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(item.href);
              return (
                <a href={item.href} aria-current={active ? 'page' : undefined} class={`transition hover:text-leaf ${active ? 'text-leaf-dark underline underline-offset-4' : ''}`}>
                  {item.label}
                </a>
              );
            })}
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-black/5 bg-white">
      <div class="mx-auto max-w-6xl px-5 py-10 sm:px-6 lg:px-8">
        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <h2 class="text-lg font-semibold tracking-tight">{person.name}</h2>
            <p class="mt-3 max-w-2xl text-sm leading-7 text-gray-600 sm:text-base">
              Plant physiology lab at CSU Monterey Bay. We study how water transport in plants
              fails under drought and heat, and how it recovers. Undergraduates do most of the research.
            </p>
          </div>

          <div class="md:justify-self-end">
            <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-leaf">
              Connect
            </h3>
            <div class="mt-3 space-y-2 text-sm text-gray-600 sm:text-base">
              <p><a href={`mailto:${person.email}`} class="hover:text-leaf">{person.email}</a></p>
              <p><a href={person.orcid} target="_blank" rel="noreferrer" class="hover:text-leaf">ORCID {person.orcidId}</a></p>
              <p><a href={person.scholar} target="_blank" rel="noreferrer" class="hover:text-leaf">Google Scholar</a></p>
              {person.researchgate && <p><a href={person.researchgate} target="_blank" rel="noreferrer" class="hover:text-leaf">ResearchGate</a></p>}
              {person.linkedin && <p><a href={person.linkedin} target="_blank" rel="noreferrer" class="hover:text-leaf">LinkedIn</a></p>}
            </div>
          </div>
        </div>

        <div class="mt-8 text-sm text-gray-500">
          © {year} {person.name}
        </div>
      </div>
    </footer>
  </body>
</html>
