---
import '../styles/site.css';
import { person, siteDescription } from '../data/site.js';

const { title, description = siteDescription } = Astro.props;
const fullTitle = title ? `${title} | ${person.name}` : person.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL('/og.png', Astro.site).href;

const nav = [
  { href: '/', label: 'Research' },
  { href: '/people/', label: 'People' },
  { href: '/publications/', label: 'Publications' },
  { href: '/teaching/', label: 'Teaching' },
  { href: '/water-path/', label: 'The Water Path' },
  { href: '/news/', label: 'News' },
  { href: '/contact/', label: 'Contact' },
];
const here = Astro.url.pathname.replace(/\/?$/, '/');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  affiliation: { '@type': 'CollegeOrUniversity', name: person.institution },
  email: `mailto:${person.email}`,
  url: 'https://cpalbuquerque.github.io/',
  sameAs: [person.scholar, person.orcid],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,600&display=swap" />
    <meta name="theme-color" content="#FFFFFF" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, plant physiologist`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-bg focus:px-3 focus:py-2">Skip to content</a>

    <header class="relative border-b border-rule">
      <div class="page flex items-center justify-between py-3">
        <a href="/" class="inline-flex min-h-[44px] items-center font-serif text-lg font-semibold text-head no-underline">{person.name}</a>

        <nav aria-label="Main" class="hidden lg:block">
          <ul class="-mx-2 flex">
            {nav.map((item) => {
              const active = here === item.href;
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class={`inline-flex min-h-[44px] items-center px-2 ${active ? 'text-accent underline decoration-2 underline-offset-4' : 'text-ink no-underline hover:text-accent'}`}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <details class="group lg:hidden">
          <summary class="inline-flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-end px-2 font-medium text-accent [&::-webkit-details-marker]:hidden">
            <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
          </summary>
          <nav aria-label="Main" class="absolute left-0 right-0 z-40 border-b border-rule bg-bg shadow-none">
            <ul class="page py-2">
              {nav.map((item) => {
                const active = here === item.href;
                return (
                  <li class="border-t border-rule first:border-t-0">
                    <a
                      href={item.href}
                      aria-current={active ? 'page' : undefined}
                      class={`flex min-h-[48px] items-center ${active ? 'font-semibold text-accent' : 'text-ink no-underline'}`}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="main" class="page py-8 md:py-12">
      <slot />
    </main>

    <footer class="page border-t border-rule py-8 text-sm text-muted">
      <p>
        {person.name}, {person.institution}.
        <a href={`mailto:${person.email}`}>{person.email}</a>
      </p>
    </footer>
  </body>
</html>
